#include <WiFi.h>
#include <esp_now.h>

// L298N input pins
#define IN1 25
#define IN2 26
#define IN3 27
#define IN4 14

// Packet must match the transmitter
typedef struct {
  float xAngle;
  float yAngle;
} TiltData;

TiltData receivedData;

volatile float xAngle = 0;
volatile float yAngle = 0;
volatile bool newData = false;

unsigned long lastPacketTime = 0;

const float THRESHOLD = 50.0;

// Stop motors
void stopCar() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

// Forward
void forward() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

// Backward
void backward() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

// Turn left
void left() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

// Turn right
void right() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

// ESP-NOW receive callback (ESP32 Arduino Core 3.x)
void OnDataRecv(const esp_now_recv_info_t *info,
                const uint8_t *data, int len) {

  if (len != sizeof(TiltData)) {
    return;
  }

  memcpy(&receivedData, data, sizeof(receivedData));

  xAngle = receivedData.xAngle;
  yAngle = receivedData.yAngle;

  lastPacketTime = millis();
  newData = true;
}

void setup() {
  Serial.begin(115200);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  stopCar();

  WiFi.mode(WIFI_STA);

  Serial.println();
  Serial.println("Receiver ESP32");
  Serial.print("MAC Address: ");
  Serial.println(WiFi.macAddress());

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW initialization failed!");
    return;
  }

  esp_now_register_recv_cb(OnDataRecv);

  Serial.println("ESP-NOW receiver ready!");
}

void loop() {

  // Stop if communication is lost
  if (millis() - lastPacketTime > 1000) {
    stopCar();
    return;
  }

  if (!newData) {
    return;
  }

  newData = false;

  // Forward / backward
  if (yAngle >= THRESHOLD) {
    forward();
  }
  else if (yAngle <= -THRESHOLD) {
    backward();
  }

  // Right / left
  else if (xAngle >= THRESHOLD) {
    right();
  }
  else if (xAngle <= -THRESHOLD) {
    left();
  }
  else {
    stopCar();
  }
}
